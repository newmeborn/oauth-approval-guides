# Copy to .env.local for local dev; set the same names in Vercel > Project > Settings > Environment Variables.
# Never commit real values.

# Gemini API key for the live guide generator (aistudio.google.com > Get API key). Free tier.
GEMINI_API_KEY=
# Optional model overrides, comma-separated, tried in order when one is overloaded.
# GEMINI_PLAN_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.8-flash
# GEMINI_WRITE_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite

# Supabase project that stores generated guides (Project Settings > API Keys).
# Server-only: the secret key is never sent to the browser. Without these, local dev saves to .data/.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
