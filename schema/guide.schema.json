    "composio": {
      "type": "object",
      "properties": {
        "toolkits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slug": {
                "type": "string"
              },
              "accessLevelIds": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Ids of access levels defined elsewhere in this guide."
              },
              "managedAuthAvailable": {
                "description": "Null if not checked.",
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "authScheme": {
                "description": "e.g. 'OAUTH2'.",
                "type": [
                  "string",
                  "null"
                ]
              },
