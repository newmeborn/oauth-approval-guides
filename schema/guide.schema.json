{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "app": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "website": {
          "type": "string"
        },
        "developerPortalUrl": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "slug",
        "website",
        "developerPortalUrl"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "generatedBy": {
          "type": "string",
          "enum": [
            "agent",
            "human_verified"
          ],
          "description": "agent: docs and web research only. human_verified: a person walked the flow."
        },
        "lastChecked": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
          "description": "ISO date, YYYY-MM-DD."
        },
        "summary": {
          "type": "string",
          "description": "Two sentences: overall verdict and the single most important thing to know."
        }
      },
      "required": [
        "generatedBy",
        "lastChecked",
        "summary"
      ],
      "additionalProperties": false
    },
    "accessLevels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable kebab-case id, unique within the guide, e.g. 'bot-verification'."
          },
          "kind": {
            "type": "string",
            "enum": [
              "sign_in",
              "read",
              "write"
            ]
          },
          "name": {
            "type": "string",
            "description": "Plain-language capability, e.g. 'Post messages to a team's channel'."
          },
          "mechanism": {
            "type": "string",
            "description": "How access is granted, e.g. 'user OAuth token', 'bot added to server', 'incoming webhook'."
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Provider scope or permission strings."
          },
          "gateIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Every gate this access level must pass, including registration."
          },
          "activeEffort": {
            "type": "object",
            "properties": {
              "min": {
                "description": "Null when unknown. Never invent a number to fill it.",
                "type": [
                  "number",
                  "null"
                ]
              },
              "max": {
                "description": "Null when unknown or open-ended.",
                "type": [
                  "number",
                  "null"
                ]
              },
              "unit": {
                "type": "string",
                "enum": [
                  "minutes",
                  "hours",
                  "days",
                  "weeks",
                  "months"
                ]
              },
              "evidence": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "enum": [
                      "tested",
                      "documented",
                      "reported",
                      "unverified"
                    ],
                    "description": "tested: we did it ourselves (needs a screenshot or test_log source). documented: an official provider or Composio page says so. reported: community sources (forums, blogs, Stack Overflow). unverified: inference or a source we could not read."
                  },
                  "sourceIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Sources backing the claim. May be empty only when label is unverified."
                  },
                  "note": {
                    "description": "Caveats, e.g. 'page blocked automated fetch; seen via search excerpt'.",
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "label",
                  "sourceIds",
                  "note"
                ],
                "additionalProperties": false,
                "description": "Shown inline next to every claim."
              }
            },
            "required": [
              "min",
              "max",
              "unit",
              "evidence"
            ],
            "additionalProperties": false,
            "description": "Hands-on developer time to reach launch, excluding waiting."
          },
          "calendarWaitToLaunch": {
            "type": "object",
            "properties": {
              "min": {
                "description": "Null when unknown. Never invent a number to fill it.",
                "type": [
                  "number",
                  "null"
                ]
              },
              "max": {
                "description": "Null when unknown or open-ended.",
                "type": [
                  "number",
                  "null"
                ]
              },
              "unit": {
                "type": "string",
                "enum": [
                  "minutes",
                  "hours",
                  "days",
                  "weeks",
                  "months"
                ]
              },
              "evidence": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "enum": [
                      "tested",
                      "documented",
                      "reported",
                      "unverified"
                    ],
                    "description": "tested: we did it ourselves (needs a screenshot or test_log source). documented: an official provider or Composio page says so. reported: community sources (forums, blogs, Stack Overflow). unverified: inference or a source we could not read."
                  },
                  "sourceIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Sources backing the claim. May be empty only when label is unverified."
                  },
                  "note": {
                    "description": "Caveats, e.g. 'page blocked automated fetch; seen via search excerpt'.",
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "label",
                  "sourceIds",
                  "note"
                ],
                "additionalProperties": false,
                "description": "Shown inline next to every claim."
              }
            },
            "required": [
              "min",
              "max",
              "unit",
              "evidence"
            ],
            "additionalProperties": false,
            "description": "Waiting on the provider before real users can connect."
          },
          "recommendation": {
            "type": "string",
            "description": "One line, e.g. 'Start verification now; launch with test users meanwhile.'"
          },
          "composioToolkit": {
            "description": "Composio toolkit slug that serves this level, e.g. 'DISCORDBOT'.",
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "enum": [
                  "tested",
                  "documented",
                  "reported",
                  "unverified"
                ],
                "description": "tested: we did it ourselves (needs a screenshot or test_log source). documented: an official provider or Composio page says so. reported: community sources (forums, blogs, Stack Overflow). unverified: inference or a source we could not read."
              },
              "sourceIds": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Sources backing the claim. May be empty only when label is unverified."
              },
              "note": {
                "description": "Caveats, e.g. 'page blocked automated fetch; seen via search excerpt'.",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "label",
              "sourceIds",
              "note"
            ],
            "additionalProperties": false,
            "description": "Shown inline next to every claim."
          }
        },
        "required": [
          "id",
          "kind",
          "name",
          "mechanism",
          "scopes",
          "gateIds",
          "activeEffort",
          "calendarWaitToLaunch",
          "recommendation",
          "composioToolkit",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable kebab-case id, unique within the guide, e.g. 'bot-verification'."
