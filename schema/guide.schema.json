          },
          "blocking": {
            "type": "boolean",
            "description": "True if you cannot proceed at all without it."
          },
          "accessLevelIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Empty means it applies to every access level."
          },
          "evidence": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "enum": [
                  "tested",
                  "documented",
                  "reported",
                  "unverified"
                ],
                "description": "tested: we did it ourselves (needs a screenshot or test_log source). documented: an official provider or Composio page says so. reported: community sources (forums, blogs, Stack Overflow). unverified: inference or a source we could not read."
              },
              "sourceIds": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Sources backing the claim. May be empty only when label is unverified."
              },
              "note": {
                "description": "Caveats, e.g. 'page blocked automated fetch; seen via search excerpt'.",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "label",
              "sourceIds",
              "note"
            ],
            "additionalProperties": false,
            "description": "Shown inline next to every claim."
          }
        },
        "required": [
          "id",
          "kind",
          "description",
          "whoNeedsIt",
          "blocking",
          "accessLevelIds",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable kebab-case id, unique within the guide, e.g. 'bot-verification'."
          },
          "title": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "actor": {
            "type": "string",
            "enum": [
              "agent",
              "agent_prepares",
              "developer"
            ],
            "description": "agent: an agent can do it end to end. agent_prepares: an agent drafts it, the developer submits. developer: only the developer can (logins, ID checks, accepting terms, payments)."
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "accessLevelIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Empty means the step applies to every access level."
          },
          "gateId": {
            "description": "The gate this step satisfies, if any.",
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "enum": [
                  "tested",
                  "documented",
                  "reported",
                  "unverified"
                ],
                "description": "tested: we did it ourselves (needs a screenshot or test_log source). documented: an official provider or Composio page says so. reported: community sources (forums, blogs, Stack Overflow). unverified: inference or a source we could not read."
              },
              "sourceIds": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Sources backing the claim. May be empty only when label is unverified."
              },
              "note": {
                "description": "Caveats, e.g. 'page blocked automated fetch; seen via search excerpt'.",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "label",
              "sourceIds",
              "note"
            ],
            "additionalProperties": false,
            "description": "Shown inline next to every claim."
          }
        },
        "required": [
          "id",
          "title",
          "detail",
          "actor",
          "url",
          "accessLevelIds",
          "gateId",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable kebab-case id, unique within the guide, e.g. 'bot-verification'."
          },
          "kind": {
            "type": "string",
            "enum": [
              "registration",
              "account_security",
              "policy_urls",
              "domain_verification",
              "brand_verification",
              "identity_verification",
              "use_case_review",
              "security_assessment",
              "business_verification",
              "paid_access",
              "partner_program"
            ],
            "description": "Pick the kind by what the provider actually checks, not by what the provider calls it."
          },
          "name": {
            "type": "string",
            "description": "The provider's own name for it, e.g. 'App Verification'."
          },
          "phase": {
            "type": "string",
            "enum": [
              "development",
              "launch",
              "scale"
            ],
            "description": "development: before even you can test. launch: before real users outside a test list can connect. scale: only after a usage threshold (put it in threshold)."
          },
          "threshold": {
            "description": "For scale gates, e.g. '100 servers'. Otherwise null.",
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": "string"
          },
          "startUrl": {
            "description": "Where the developer starts this gate.",
            "type": [
              "string",
              "null"
            ]
          },
          "typicalWait": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "min": {
                    "description": "Null when unknown. Never invent a number to fill it.",
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "max": {
                    "description": "Null when unknown or open-ended.",
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "unit": {
                    "type": "string",
                    "enum": [
                      "minutes",
                      "hours",
                      "days",
                      "weeks",
                      "months"
                    ]
                  },
                  "evidence": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string",
                        "enum": [
                          "tested",
                          "documented",
                          "reported",
                          "unverified"
                        ],
                        "description": "tested: we did it ourselves (needs a screenshot or test_log source). documented: an official provider or Composio page says so. reported: community sources (forums, blogs, Stack Overflow). unverified: inference or a source we could not read."
                      },
                      "sourceIds": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "description": "Sources backing the claim. May be empty only when label is unverified."
                      },
                      "note": {
                        "description": "Caveats, e.g. 'page blocked automated fetch; seen via search excerpt'.",
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "label",
                      "sourceIds",
                      "note"
                    ],
                    "additionalProperties": false,
                    "description": "Shown inline next to every claim."
                  }
                },
                "required": [
                  "min",
                  "max",
                  "unit",
                  "evidence"
                ],
                "additionalProperties": false,
                "description": "A range, never a point estimate. Use the unit a developer would plan in."
              },
              {
                "type": "null"
              }
            ],
            "description": "Calendar wait for a decision. Null if the gate is instant."
          },
          "cost": {
            "anyOf": [
              {
                "type": "object",
